PORT=3000
NODE_ENV=development

# Required, the app exits on boot without it
MONGOOSE_URL=mongodb+srv://user:password@cluster.mongodb.net/hamro_samadhan

# The browser origin allowed by CORS. Comma separated when the frontend is
# reachable on more than one host, e.g. a Vercel production host plus its
# preview hosts. Without this the backend defaults to http://localhost:5173,
# every request from a deployed frontend is blocked by the browser, and the
# symptom is an empty category dropdown rather than a CORS error.
# Render: set this in the dashboard, then redeploy.
CLIENT_URL=https://hamrosamadhan.vercel.app,https://hamro-samadhan-git-main.vercel.app

# Comma separated list of TRUST_PROXY_HOPS values, only for deployments behind
# a proxy such as Render or Vercel, so express reads the client IP correctly
# and the rate limiter does not treat every visitor as one client
TRUST_PROXY_HOPS=1

# Cloudinary, required for the report image upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend, required for the notification emails
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Seeded by scripts/seedAdmin.js
ADMIN_EMAIL=admin@hamrosamadhan.com
ADMIN_PASSWORD=
