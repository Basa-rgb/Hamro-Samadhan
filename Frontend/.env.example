# Full base URL of the deployed backend, ending in /api
# Local:  http://localhost:3000/api
# Vercel: set this in Project Settings > Environment Variables, and add it for
# Production, Preview AND Development, then redeploy. A rebuild is required,
# Vite inlines the value at build time so a change alone does nothing.
VITE_API_URL=http://localhost:3000/api